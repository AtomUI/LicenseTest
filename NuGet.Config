<configuration>
  <packageSources>
    <clear />
    <add key="AtomUILocal" value="/Users/chinboy/Data/nuget-atomui-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="AtomUILocal">
      <package pattern="AtomUI.Desktop.Controls.DataGrid.Commercial" />
      <package pattern="AtomUI.License" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
